# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=PLAIN
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -amdgpu-sched-strategy=coexec \
# RUN:     -run-pass=amdgpu-global-sched -debug-only=amdgpu-global-sched -o /dev/null %s \
# RUN:     2>&1 | FileCheck %s --check-prefix=COEXEC
# REQUIRES: asserts

# What the machine makes an instruction wait for beyond its operands.
#
# Almost every hazard this target knows is stated over physical registers,
# and there are none yet at this point in the pipeline, so almost nothing is
# visible here. The co-execution window is the exception: an MFMA holds slots
# of the VALU pipe for a fixed pattern of cycles afterwards, and which slot an
# instruction lands in is decided by the order alone.
#
# So the same code has no hazards under the default strategy and real ones
# under coexec, and that is not a limitation of the measurement -- it is the
# only hazard model that exists before register allocation.

# PLAIN: amdgpu-global-sched: hazards: 0 wait states, 0 instrs
# COEXEC: amdgpu-global-sched: hazards: 1 wait states, 1 instrs

---
name:            coexec_window
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15, $vgpr8

    %0:vreg_128_align2 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
    %1:vreg_128_align2 = COPY $vgpr4_vgpr5_vgpr6_vgpr7
    %2:areg_512_align2 = COPY $agpr0_agpr1_agpr2_agpr3_agpr4_agpr5_agpr6_agpr7_agpr8_agpr9_agpr10_agpr11_agpr12_agpr13_agpr14_agpr15
    %3:vgpr_32 = COPY $vgpr8

    %4:areg_512_align2 = V_MFMA_F32_32X32X16_BF16_e64 %0, %1, %2, 0, 0, 0, implicit $mode, implicit $exec

    %5:vgpr_32 = V_ADD_U32_e32 %3, %3, implicit $exec
    %6:vgpr_32 = V_ADD_U32_e32 %5, %5, implicit $exec
    %7:vgpr_32 = V_ADD_U32_e32 %6, %6, implicit $exec
    %8:vgpr_32 = V_ADD_U32_e32 %7, %7, implicit $exec

    S_ENDPGM 0, implicit %4, implicit %8
...
