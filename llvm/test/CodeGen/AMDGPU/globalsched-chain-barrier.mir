# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# The chain is measured along dependence edges, so an instruction nothing can
# wait for contributes nothing to it, however long the machine model says it
# takes.
#
# S_BARRIER is modelled at 500 cycles (SISchedule.td, "XXX: Guessed ???") --
# a wave waiting for its siblings, not a value being computed. Everything in
# the block is ordered against it, so it is on the chain; but it defines no
# register anyone can read, so the edges leaving it weigh nothing and nothing
# after it is later because of it. Charging its latency would report 500
# cycles for every function containing a barrier, which is what this test is
# here to catch.

# CHECK: amdgpu-global-sched: chain: 4 instrs, 2 cycles, 4 critical
# CHECK-DAG: amdgpu-global-sched:   %bb.0 S_BARRIER start 0 slack 0 lat 0

---
name:            chain_barrier
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    S_BARRIER
    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec
    S_ENDPGM 0, implicit %1
...
