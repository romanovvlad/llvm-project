# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# Two stores only have to keep their order if they can reach the same bytes.
#
# These three writes share a base and differ by their constant offsets, so
# none of them can see another's bytes and all three may issue in any order.
# The read is at offset 0, so it waits for the first write and for neither of
# the others.
#
# Ordering every store against every other would make a run of six here, and
# on a real kernel it makes the chain run through all sixteen writes of an
# LDS tile -- a chain the hardware never has to honour.

# CHECK: amdgpu-global-sched: path by steps: 4 instrs, 3 steps
# CHECK: on steps %bb.0 COPY
# CHECK-NEXT: on steps %bb.0 DS_WRITE_B32_gfx9
# CHECK-NEXT: on steps %bb.0 DS_READ_B32_gfx9
# CHECK-NEXT: on steps %bb.0 S_ENDPGM

---
name:            chain_alias
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1

    DS_WRITE_B32_gfx9 %0, %1, 0, 0, implicit $exec :: (store (s32), addrspace 3)
    DS_WRITE_B32_gfx9 %0, %1, 4, 0, implicit $exec :: (store (s32), addrspace 3)
    DS_WRITE_B32_gfx9 %0, %1, 8, 0, implicit $exec :: (store (s32), addrspace 3)

    %2:vgpr_32 = DS_READ_B32_gfx9 %0, 0, 0, implicit $exec :: (load (s32), addrspace 3)

    S_ENDPGM 0, implicit %2
...
