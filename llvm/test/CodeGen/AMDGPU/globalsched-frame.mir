# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# The chain the regions are cut by is a coordinate system, not a decision.
# Every schedule is still describable in the cut, whichever chain is used, so
# the chain may be chosen for the search it leaves rather than for its length.
#
# What it should be chosen for is spread. A region holding k instructions
# costs log2(k!) to order, so one long chain through one corner of the
# function is the worst possible cut: everything else lands in the single
# region beyond it. Which region an instruction sits in today is just how many
# steps the order has passed, so a region is a gap in that order and the cost
# of a chain is a sum over its edges -- a shortest path.
#
# Here the longest chain is the seven adds at the top, and taking it leaves
# all eleven instructions below in one region. The six-add chain further down
# is one step shorter, but its steps are spaced out, so taking it leaves no
# region larger than seven.
#
# What cannot be done is to make the cut finer by promoting instructions that
# dependence allows into one region only. There are none. Such an instruction
# would sit between two consecutive steps, which are joined by an edge, so
# routing the path through it would make the longest path longer still.
#
# A step also need not be joined to the one before it by an edge -- being
# ordered against it is all a step has to be, and a dependence path says that
# too. So the hops may skip, and here they do: the chain that minimises the
# ordering over all the regions reaches seven steps, but the chain that
# minimises the single worst region gets there in three, because the four it
# leaves out separated nothing and cost placement to say so.
#
# Seven is then a floor and not a starting point. Both objectives are solved
# exactly over every chain, so no cut by any chain leaves a region smaller.

# CHECK: amdgpu-global-sched: search: {{.*}} largest region 11
# CHECK: amdgpu-global-sched: frame: 7 on the path, {{.*}} largest region 7
# CHECK: amdgpu-global-sched: worst: 3 on the path, {{.*}} largest region 7

---
name:            coarse_cut
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0

    ; The longest chain, and all of it in one place.
    %1:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec
    %2:vgpr_32 = V_ADD_U32_e32 %1, %1, implicit $exec
    %3:vgpr_32 = V_ADD_U32_e32 %2, %2, implicit $exec
    %4:vgpr_32 = V_ADD_U32_e32 %3, %3, implicit $exec
    %5:vgpr_32 = V_ADD_U32_e32 %4, %4, implicit $exec
    %6:vgpr_32 = V_ADD_U32_e32 %5, %5, implicit $exec
    %7:vgpr_32 = V_ADD_U32_e32 %6, %6, implicit $exec

    ; A shorter one, spread through what is left.
    %8:vgpr_32 = V_MUL_U32_U24_e32 %0, %0, implicit $exec
    %20:vgpr_32 = V_XOR_B32_e32 %0, %0, implicit $exec
    %9:vgpr_32 = V_MUL_U32_U24_e32 %8, %8, implicit $exec
    %21:vgpr_32 = V_XOR_B32_e32 %0, %0, implicit $exec
    %10:vgpr_32 = V_MUL_U32_U24_e32 %9, %9, implicit $exec
    %22:vgpr_32 = V_XOR_B32_e32 %0, %0, implicit $exec
    %11:vgpr_32 = V_MUL_U32_U24_e32 %10, %10, implicit $exec
    %23:vgpr_32 = V_XOR_B32_e32 %0, %0, implicit $exec
    %12:vgpr_32 = V_MUL_U32_U24_e32 %11, %11, implicit $exec
    %24:vgpr_32 = V_XOR_B32_e32 %0, %0, implicit $exec
    %13:vgpr_32 = V_MUL_U32_U24_e32 %12, %12, implicit $exec

    S_ENDPGM 0, implicit %7, implicit %13, implicit %20, implicit %21, implicit %22, implicit %23, implicit %24
...
