# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# REQUIRES: asserts
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -run-pass=machine-scheduler -amdgpu-disable-rewrite-mfma-form-sched-stage=false -debug-only=machine-scheduler -o /dev/null %s 2>&1 | FileCheck %s

# The rewrite is measured in every region, not only in those over the ArchVGPR
# limit. The ballast is live in bb.1 only, so bb.2 is under the limit, but the
# second chain still moves into AGPRs there and the estimate has to show it.

# CHECK: region 2: ArchVGPR 10 -> 2, AGPR 0 -> 8, spills 0 -> 0
# CHECK: probe 2/2 chains

--- |
  define void @measure_all_regions() #0 {
  entry:
    unreachable
  }
  attributes #0 = { "amdgpu-waves-per-eu"="1,1" "amdgpu-flat-work-group-size"="64,64" }
...

---
name:            measure_all_regions
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1(0x80000000)

    %p0:vreg_1024 = IMPLICIT_DEF
    %p1:vreg_1024 = IMPLICIT_DEF
    %p2:vreg_1024 = IMPLICIT_DEF
    %p3:vreg_1024 = IMPLICIT_DEF
    %p4:vreg_1024 = IMPLICIT_DEF
    %p5:vreg_1024 = IMPLICIT_DEF
    %p6:vreg_1024 = IMPLICIT_DEF
    %p7:vreg_1024 = IMPLICIT_DEF
    %p8:vreg_1024 = IMPLICIT_DEF
    %srca:vgpr_32 = IMPLICIT_DEF
    %srcb:vgpr_32 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    %a:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, 0, 0, 0, 0, implicit $mode, implicit $exec
    %b:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %a, 0, 0, 0, implicit $mode, implicit $exec
    %c:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %b, 0, 0, 0, implicit $mode, implicit $exec
    KILL %p0, %p1, %p2, %p3, %p4, %p5, %p6, %p7, %p8
    S_NOP 0, implicit %c
    S_BRANCH %bb.2

  bb.2:
    %d:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, 0, 0, 0, 0, implicit $mode, implicit $exec
    %e:vreg_128_align2 = nofpexcept V_MFMA_F32_16X16X4F32_vgprcd_e64 %srca, %srcb, %d, 0, 0, 0, implicit $mode, implicit $exec
    S_NOP 0, implicit %e
    S_ENDPGM 0
...
