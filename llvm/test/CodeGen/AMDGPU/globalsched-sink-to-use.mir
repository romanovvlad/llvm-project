# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# A value computed in bb.0 and read only in bb.2.
#
# Nothing here is a motion. The legal set for the add is every block on the
# dominator path from where its operands are defined to where its result is
# read, which is bb.0, bb.1 and bb.2; all three have the same loop depth; the
# tie goes to the latest, because that is the schedule in which the value is
# live across the fewest blocks. That the input happened to say bb.0 is not a
# starting point the result is measured against.

---
name:            sink_to_use
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: sink_to_use

  ; CHECK: bb.0:
  ; CHECK: COPY $vgpr0
  ; CHECK: COPY $vgpr1
  ; CHECK-NOT: V_ADD_U32_e32

  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec

  ; CHECK: bb.1:
  ; CHECK-NOT: V_ADD_U32_e32

  bb.1:
    successors: %bb.2

    S_NOP 0

  ; CHECK: bb.2:
  ; CHECK: [[ADD:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec
  ; CHECK-NEXT: S_ENDPGM 0, implicit [[ADD]]

  bb.2:
    S_ENDPGM 0, implicit %2
...
