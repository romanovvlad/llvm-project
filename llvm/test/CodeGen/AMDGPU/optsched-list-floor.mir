# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=machine-scheduler \
# RUN:     -misched=amdgpu-optsched -amdgpu-optsched-window-step-limit=0 \
# RUN:     -debug-only=amdgpu-optsched -o - %s 2>&1 \
# RUN:   | FileCheck %s
#
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -run-pass=machine-scheduler \
# RUN:     -misched=amdgpu-optsched -amdgpu-optsched-window-step-limit=0 \
# RUN:     -amdgpu-optsched-list-floor=0 \
# RUN:     -debug-only=amdgpu-optsched -o - %s 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOFLOOR
#
# REQUIRES: asserts

# Losing an answer must not cost the region its schedule.
#
# This is the region from optsched-window.mir -- source order is 33 cycles, the
# list scheduler finds 26, the window search finds 19 -- with the window search
# given no steps to spend. It comes back with the order it started from, which
# the cost gate refuses for not being strictly better, correctly.
#
# What the region must not do at that point is ship at 33. -misched=amdgpu-optsched
# replaces GCNSchedStrategy outright, so the order we fall back to is whatever
# arrived from the pre-scheduler, and nothing downstream will improve it. The
# list schedule is a legal order we already know how to build and it is seven
# cycles shorter, so it is the floor: when the real answer loses, the region
# gets that instead of the order it came in with.
#
# The floor goes through the same gates as any other answer -- it is adopted
# only if it verifies, is strictly cheaper, and raises neither the register
# shortfall nor measured demand -- so a region whose list schedule is worse than
# what it arrived with still keeps what it arrived with.

# CHECK: optsched: {{.*}} n=18 {{.*}} solver=window status=upper-bound makespan=33 (source 33)
# CHECK: not strictly better, keeping the existing order
# CHECK: optsched: applying list floor, 33 -> 26 cycles

# NOFLOOR: optsched: {{.*}} n=18 {{.*}} solver=window status=upper-bound makespan=33 (source 33)
# NOFLOOR: not strictly better, keeping the existing order
# NOFLOOR-NOT: optsched: applying

---
name:            list_floor_catches_a_lost_answer
tracksRegLiveness: true
body:             |
  bb.0:
    %0:av_64_align2 = IMPLICIT_DEF
    %1:areg_128_align2 = IMPLICIT_DEF
    %10:sreg_32 = S_MOV_B32 1
    %11:sreg_32 = S_ADD_I32 %10, %10, implicit-def dead $scc
    %12:sreg_32 = S_ADD_I32 %11, %11, implicit-def dead $scc
    %13:sreg_32 = S_ADD_I32 %12, %12, implicit-def dead $scc
    %14:sreg_32 = S_ADD_I32 %13, %13, implicit-def dead $scc
    %15:sreg_32 = S_ADD_I32 %14, %14, implicit-def dead $scc
    %16:sreg_32 = S_ADD_I32 %15, %15, implicit-def dead $scc
    %17:sreg_32 = S_ADD_I32 %16, %16, implicit-def dead $scc
    %18:sreg_32 = S_ADD_I32 %17, %17, implicit-def dead $scc
    %19:sreg_32 = S_ADD_I32 %18, %18, implicit-def dead $scc
    %20:sreg_32 = S_ADD_I32 %19, %19, implicit-def dead $scc
    %21:sreg_32 = S_ADD_I32 %20, %20, implicit-def dead $scc
    %22:sreg_32 = S_ADD_I32 %21, %21, implicit-def dead $scc
    %23:sreg_32 = S_ADD_I32 %22, %22, implicit-def dead $scc
    %2:areg_128_align2 = V_MFMA_F32_16X16X16F16_e64 %0, %0, %1, 0, 0, 0, implicit $mode, implicit $exec
    %3:areg_128_align2 = V_MFMA_F32_16X16X16F16_e64 %0, %0, %1, 0, 0, 0, implicit $mode, implicit $exec
    S_ENDPGM 0, implicit %2, implicit %3, implicit %23
...
