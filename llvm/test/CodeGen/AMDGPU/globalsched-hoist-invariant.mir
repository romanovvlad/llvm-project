# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -verify-machineinstrs -o - %s | FileCheck %s

# A value whose operands are both defined before a loop, and which is read by a
# store inside it.
#
# There is no loop-invariant-code-motion rule here. The legal set is bb.0 and
# bb.1, and bb.0 is the one the objective prefers, because a block inside a
# loop is weighted by how often it runs. The store is pinned, so it stays, and
# the add it reads is scheduled outside.

---
name:            hoist_invariant
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: hoist_invariant

  ; CHECK: bb.0:
  ; CHECK: [[ADD:%[0-9]+]]:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec

  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2_vgpr3, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = COPY $vgpr1
    %2:vreg_64_align2 = COPY $vgpr2_vgpr3
    %3:sreg_32 = COPY $sgpr0

  ; CHECK: bb.1:
  ; CHECK-NOT: V_ADD_U32_e32
  ; CHECK: GLOBAL_STORE_DWORD %2, [[ADD]], 0, 0, implicit $exec

  bb.1:
    successors: %bb.1, %bb.2

    %4:sreg_32 = PHI %3, %bb.0, %6, %bb.1
    %5:vgpr_32 = V_ADD_U32_e32 %0, %1, implicit $exec
    GLOBAL_STORE_DWORD %2, %5, 0, 0, implicit $exec
    %6:sreg_32 = S_ADD_I32 %4, -1, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
