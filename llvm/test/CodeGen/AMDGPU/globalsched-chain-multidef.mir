# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# An instruction defining more registers than the scheduling model has writes
# for. S_UADDO_PSEUDO produces a sum and a carry; SISchedule.td names one
# write. Asking for the latency of the second def makes
# TargetSchedModel::computeOperandLatency report an incomplete model and
# abort, which it did on every kernel using 64-bit address arithmetic.
#
# There is no better number available, so the instruction's own latency is
# the answer for both of its results.

# CHECK: amdgpu-global-sched: chain: 6 instrs, 3 cycles, 6 critical

---
name:            chain_multidef
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0, $sgpr1

    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    %2:sreg_32, %3:sreg_64_xexec = S_UADDO_PSEUDO %0, %1, implicit-def dead $scc
    %4:sreg_32 = S_ADD_I32 %2, 1, implicit-def dead $scc
    %5:sreg_64 = S_AND_B64 %3, %3, implicit-def dead $scc
    S_ENDPGM 0, implicit %4, implicit %5
...
