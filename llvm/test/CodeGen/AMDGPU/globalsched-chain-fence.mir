# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# A barrier is an ordering constraint even though it is not a value.
#
# The two halves here share nothing: neither reads what the other writes. On
# the values alone they are two chains of three, and the longest run of
# instructions that cannot be exchanged is three. But nothing may cross
# S_BARRIER in either direction, so the real answer is that all six are
# pairwise ordered -- the first half, the barrier, the second half.
#
# This is the constraint that actually partitions a kernel, and the SSA graph
# does not contain it.

# CHECK: amdgpu-global-sched: path by steps: 6 instrs, 5 steps
# CHECK: on steps %bb.0 COPY
# CHECK-NEXT: on steps %bb.0 V_ADD_U32_e32
# CHECK-NEXT: on steps %bb.0 S_BARRIER
# CHECK-NEXT: on steps %bb.0 COPY
# CHECK-NEXT: on steps %bb.0 V_ADD_U32_e32
# CHECK-NEXT: on steps %bb.0 S_ENDPGM

---
name:            chain_fence
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec

    S_BARRIER

    %2:vgpr_32 = COPY $vgpr1
    %3:vgpr_32 = V_ADD_U32_e32 %2, %2, implicit $exec

    S_ENDPGM 0, implicit %1, implicit %3
...
