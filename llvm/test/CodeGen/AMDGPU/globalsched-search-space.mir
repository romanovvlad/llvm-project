# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# How big the problem is once the regions have cut it up.
#
# Two numbers. Choosing a region for every instruction not on the path costs
# the log of the product of the window widths. Ordering what lands in each
# region costs the log of the product of the factorials of the occupancies.
# Both are in bits, so they add, and the sum is the size of the space a
# search has to cover.
#
# Here the path is COPY, the last add, the barrier, the end. The other two
# adds are each legal in two regions -- one bit each -- and both currently
# sit in the same region, which can be ordered two ways for one bit more.

# CHECK: amdgpu-global-sched: path by control: 4 instrs, 2 control, 3 steps
# CHECK: region 0: 0 legal, 0 now
# CHECK-NEXT: region 1: 2 legal, 2 now
# CHECK-NEXT: region 2: 2 legal, 0 now
# CHECK: amdgpu-global-sched: search: 2 bits to place, 1 to order, 3 total, largest region 2

---
name:            search_space
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $vgpr0

    %0:vgpr_32 = COPY $vgpr0
    %1:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec
    %2:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec
    %3:vgpr_32 = V_ADD_U32_e32 %0, %0, implicit $exec
    S_BARRIER
    S_ENDPGM 0, implicit %1, implicit %2, implicit %3
...
