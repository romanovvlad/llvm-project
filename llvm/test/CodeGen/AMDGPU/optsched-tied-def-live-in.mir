# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-scheduler \
# RUN:     -misched=amdgpu-optsched \
# RUN:     -debug-only=amdgpu-optsched,amdgpu-optsched-regs \
# RUN:     -o /dev/null %s 2>&1 | FileCheck %s
#
# REQUIRES: asserts

# A value a tied operand rewrites was already live.
#
# V_PERMLANE32_SWAP_B32 reads two registers and writes them back, so each one
# is both a use and a def of the same vreg. buildRegisterModel decided
# live-in by "has no definition in this region", which such a value does have,
# so the model believed its range *started* at the swap and counted nothing
# above it. In _attn_fwd's hot block that lost it 120 VGPRs, enough that a
# region needing 320 of 256 scored excess 0 and the objective collapsed to
# makespan.
#
# The physical-register half of the same function already guards against this
# -- "the operands outrank the flag" -- because getting it wrong there wrapped
# a running count. Getting it wrong for a vreg is silent.
#
# %0 and %1 come from bb.0 and are swapped in bb.1 without being read first.
# The model has to count them across the whole region, not from the swap on,
# so it must agree with the trackers.

# The gate reports, per position, the worst amount by which the model falls
# below what the trackers measure. Nowhere, is the whole assertion: the model
# may sit above the trackers -- it rounds a value up to its class and keeps a
# dead definition for the cycle that writes it -- but below is a region that
# looks like it fits when it does not.

# CHECK: optsched: {{.*}} n=11 {{.*}} makespan=82 (source 91)
# CHECK: optsched: demand 4+0 VGPR / 2 SGPR -> 4+0 VGPR / 2 SGPR
# CHECK-NOT: optsched: model low by

---
name:            tied_def_is_live_in
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    %0:vgpr_32 = IMPLICIT_DEF
    %1:vgpr_32 = IMPLICIT_DEF

  bb.1:
    successors: %bb.2
    %4:vreg_64_align2 = IMPLICIT_DEF
    %20:sreg_32 = S_MOV_B32 1
    %21:sreg_32 = S_ADD_I32 %20, %20, implicit-def dead $scc
    %22:sreg_32 = S_ADD_I32 %21, %21, implicit-def dead $scc
    %23:sreg_32 = S_ADD_I32 %22, %22, implicit-def dead $scc
    %24:sreg_32 = S_ADD_I32 %23, %23, implicit-def dead $scc
    %25:sreg_32 = S_ADD_I32 %24, %24, implicit-def dead $scc
    %26:sreg_32 = S_ADD_I32 %25, %25, implicit-def dead $scc
    %27:sreg_32 = S_ADD_I32 %26, %26, implicit-def dead $scc
    %0:vgpr_32, %1:vgpr_32 = V_PERMLANE32_SWAP_B32_e32 %0, %1, implicit $exec
    %6:vgpr_32 = GLOBAL_LOAD_DWORD %4, 0, 0, implicit $exec

  bb.2:
    S_ENDPGM 0, implicit %0, implicit %1, implicit %6, implicit %27
...
