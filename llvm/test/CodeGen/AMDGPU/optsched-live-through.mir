# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=machine-scheduler \
# RUN:     -misched=amdgpu-optsched -debug-only=amdgpu-optsched -o /dev/null %s 2>&1 \
# RUN:   | FileCheck %s
#
# REQUIRES: asserts

# A value that crosses a region without being named in it still holds its
# registers there.
#
# The register model is built from the operands of the instructions in the
# region, so a vreg defined above the region and read below it -- never
# mentioned inside -- used to be invisible to it. The model then reported a
# region that fits while the allocator saw one that does not, and because
# Cost::Excess is the first term the whole objective degenerated to makespan:
# the search was free to lengthen every live range for a cycle it could not
# actually spend.
#
# %0-%3 are four 128-bit values, sixteen VGPRs, live across bb.1 and read in
# bb.2. bb.1's own peak is two VGPRs on its own, so eighteen with them.
#
# bb.0 defines those same values, so nothing is live through it: the two
# regions together say the term is added where it belongs and nowhere else.

# CHECK: optsched: {{.*}} n=4 {{.*}} live-through 0+0 VGPR / 0 SGPR
# CHECK: optsched: cost (excess 0, 4 cycles, peak 16)
# CHECK: optsched: {{.*}} n=3 {{.*}} live-through 16+0 VGPR / 0 SGPR
# CHECK: optsched: cost (excess 0, 4 cycles, peak 18)

---
name:            live_through_counts
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1
    %0:vreg_128 = IMPLICIT_DEF
    %1:vreg_128 = IMPLICIT_DEF
    %2:vreg_128 = IMPLICIT_DEF
    %3:vreg_128 = IMPLICIT_DEF

  bb.1:
    successors: %bb.2
    %10:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %11:vgpr_32 = V_ADD_U32_e32 %10, %10, implicit $exec
    %12:vgpr_32 = V_ADD_U32_e32 %11, %11, implicit $exec

  bb.2:
    S_ENDPGM 0, implicit %0, implicit %1, implicit %2, implicit %3, implicit %12
...
