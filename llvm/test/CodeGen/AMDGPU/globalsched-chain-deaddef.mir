# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -run-pass=amdgpu-global-sched \
# RUN:     -debug-only=amdgpu-global-sched -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# Two writes of a register have to keep their order so that whoever reads the
# second does not see the first. Nobody reads these: every SALU instruction
# writes SCC and almost none of them mean to, so the def is marked dead.
#
# A write nobody reads still clobbers, so what came before it keeps its edge
# to it -- but nothing needs to come after it, so the next write need not
# wait. Ordering them anyway puts every SALU instruction of a block on one
# chain; kernels run long runs of these, and this one is thirty-two wide in
# _rot_q_kernel.
#
# globalsched-chain-physreg.mir is the other half: a def that is read does
# order what follows it.

# CHECK: amdgpu-global-sched: path by steps: 3 instrs, 2 steps
# CHECK: on steps %bb.0 COPY
# CHECK-NEXT: on steps %bb.0 S_AND_B64
# CHECK-NEXT: on steps %bb.0 S_ENDPGM

---
name:            chain_deaddef
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $sgpr0_sgpr1

    %0:sreg_64 = COPY $sgpr0_sgpr1
    %1:sreg_64 = S_AND_B64 %0, %0, implicit-def dead $scc
    %2:sreg_64 = S_AND_B64 %0, %0, implicit-def dead $scc
    %3:sreg_64 = S_AND_B64 %0, %0, implicit-def dead $scc

    S_ENDPGM 0, implicit %1, implicit %2, implicit %3
...
